// 資源檔只放英文字，中文在程式執行時才設定，避免編譯器字碼頁問題
#include <windows.h>
#include "../src/resource.h"

1 ICON "app.ico"
1 24 "app.manifest"

IDD_MAIN DIALOGEX 0, 0, 220, 218
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "PC Lockdown"
FONT 9, "MS Shell Dlg", 0, 0, 1
BEGIN
    LTEXT           "", 2100, 14, 13, 134, 10
    AUTOCHECKBOX    "", 2000, 152, 10, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", 2101, 14, 31, 134, 10
    AUTOCHECKBOX    "", 2001, 152, 28, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", 2102, 14, 49, 134, 10
    AUTOCHECKBOX    "", 2002, 152, 46, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", 2103, 14, 67, 134, 10
    AUTOCHECKBOX    "", 2003, 152, 64, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", 2104, 14, 85, 134, 10
    AUTOCHECKBOX    "", 2004, 152, 82, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", 2105, 14, 103, 134, 10
    AUTOCHECKBOX    "", 2005, 152, 100, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", 2106, 14, 121, 134, 10
    AUTOCHECKBOX    "", 2006, 152, 118, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", 2107, 14, 139, 134, 10
    AUTOCHECKBOX    "", 2007, 152, 136, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", 2108, 14, 157, 134, 10
    AUTOCHECKBOX    "", 2008, 152, 154, 56, 15, BS_PUSHLIKE | WS_TABSTOP
    LTEXT           "", IDC_SYSINFO, 7, 178, 206, 10
    PUSHBUTTON      "Password", IDC_CHPWD, 7, 195, 64, 16, WS_TABSTOP
    PUSHBUTTON      "Uninstall", IDC_UNINSTALL, 78, 195, 64, 16, WS_TABSTOP
    PUSHBUTTON      "Exit", IDCANCEL, 149, 195, 64, 16, WS_TABSTOP
END

IDD_PWD DIALOGEX 0, 0, 210, 92
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password"
FONT 9, "MS Shell Dlg", 0, 0, 1
BEGIN
    LTEXT           "", IDC_PWD_LABEL1, 7, 10, 62, 10
    EDITTEXT        IDC_PWD1, 72, 8, 131, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PWD_LABEL2, 7, 29, 62, 10
    EDITTEXT        IDC_PWD2, 72, 27, 131, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PWD_MSG, 7, 48, 196, 18
    DEFPUSHBUTTON   "OK", IDOK, 97, 71, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 153, 71, 50, 14, WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404b0"
        BEGIN
            VALUE "FileDescription", "PC Lockdown"
            VALUE "FileVersion", "1.3.0"
            VALUE "ProductName", "PC Lockdown"
            VALUE "ProductVersion", "1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
